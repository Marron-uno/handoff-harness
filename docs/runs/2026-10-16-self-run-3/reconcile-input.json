    {
      "id": "I-1",
      "kind": "block",
      "title": "Heredoc bodies written to a file are dropped from the judged text",
      "criteria": [
        {
          "id": "C-1",
          "text": "A heredoc body that a command only writes to a file (cat or tee with a redirect) is left out of the text before the deny patterns, the push rule and the sensitive-path scan run, so prose in the body is not judged as a command line."
        },
        {
          "id": "C-2",
          "text": "A heredoc fed to a shell or an interpreter (bash, sh, zsh, node, python and the like) is still scanned in full."
        }
      ],
      "ui": false,
      "inScope": true,
