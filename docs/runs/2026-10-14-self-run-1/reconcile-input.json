    {
      "id": "I-2",
      "kind": "block",
      "title": "Preflight check bundle_size",
      "criteria": [
        {
          "id": "C-2",
          "text": "Preflight fails when a file named in budgets.bundleBytes is larger than its cap, and the failure details name the file, its size and its cap."
        },
        {
          "id": "C-3",
          "text": "Preflight passes when every file named in budgets.bundleBytes is at or under its cap, and skips when the map is empty or absent."
        },
        {
          "id": "C-4",
          "text": "A file named in budgets.bundleBytes that does not exist is skipped, not failed, and the details list it."
        }
      ],
      "ui": false,
      "inScope": true,
